{
  "manifest_version": 3,
  "name": "Lecture Notebook AI",
  "short_name": "Lecture Notebook AI",
  "version": "1.4.0",
  "description": "Open Lecture Notebook AI or record a user-selected tab, window, or screen locally and open it for review.",
  "author": "Xenogenesis Xtreme",
  "homepage_url": "https://github.com/XenogenesisXtreme/lecture-notebook-ai-mvp",
  "minimum_chrome_version": "109",
  "action": {
    "default_title": "Lecture Notebook AI",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["desktopCapture", "downloads", "offscreen", "storage"],
  "host_permissions": ["https://lecturenoteb-hxgiwwjj.manus.space/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://lecturenoteb-hxgiwwjj.manus.space/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
